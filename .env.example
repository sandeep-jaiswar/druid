# Druid Pipeline Application Configuration
# Environment variables for Docker deployment

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=stock-data
KAFKA_GROUP_ID=druid-kafka-indexing-service
KAFKA_AUTO_OFFSET_RESET=latest

# Druid Configuration  
DRUID_COORDINATOR_URL=http://coordinator:8081
DRUID_OVERLORD_URL=http://overlord:8090
DRUID_ROUTER_URL=http://router:8888
DRUID_DATASOURCE=stock_data

# Ingestion Configuration
INGESTION_TASK_COUNT=1
INGESTION_REPLICAS=1
INGESTION_TASK_DURATION=PT3600S
INGESTION_MAX_ROWS_MEMORY=100000
INGESTION_SEGMENT_GRANULARITY=DAY
INGESTION_QUERY_GRANULARITY=MINUTE

# Flask Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# Logging Configuration
LOG_LEVEL=INFO