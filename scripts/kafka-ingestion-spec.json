{
  "type": "kafka",
  "spec": {
    "dataSchema": {
      "dataSource": "stocks",
      "timestampSpec": {
        "column": "Datetime",
        "format": "auto"
      },
      "dimensionsSpec": {
        "dimensions": [
          "ticker",
          "Datetime",
          {
            "type": "string",
            "name": "fetch_timestamp"
          }
        ]
      },
      "metricsSpec": [
        {
          "type": "doubleSum",
          "name": "sum_open",
          "fieldName": "Open_AAPL"
        },
        {
          "type": "doubleSum",
          "name": "sum_high",
          "fieldName": "High_AAPL"
        },
        {
          "type": "doubleSum",
          "name": "sum_low",
          "fieldName": "Low_AAPL"
        },
        {
          "type": "doubleSum",
          "name": "sum_close",
          "fieldName": "Close_AAPL"
        },
        {
          "type": "doubleSum",
          "name": "sum_volume",
          "fieldName": "Volume_AAPL"
        },
        {
          "type": "count",
          "name": "count"
        }
      ],
      "granularitySpec": {
        "type": "uniform",
        "segmentGranularity": "HOUR",
        "queryGranularity": "MINUTE",
        "rollup": false
      }
    },
    "ioConfig": {
      "topic": "stocks",
      "inputFormat": {
        "type": "json"
      },
      "consumerProperties": {
        "bootstrap.servers": "kafka:9092"
      },
      "taskCount": 1,
      "replicas": 1,
      "taskDuration": "PT1H",
      "useEarliestOffset": true
    },
    "tuningConfig": {
      "type": "kafka",
      "maxRowsPerSegment": 5000000
    }
  }
}
